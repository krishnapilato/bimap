{
  "name": "bimap",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "prestart": "npm run check:start",
    "start": "ng serve",
    "prestart:demo": "npm run check:start",
    "start:demo": "ng serve --configuration demo",
    "check:start": "npm run typecheck && npm run lint && npm run knip",
    "check": "npm run check:start && ng test --watch=false && ng build",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "lighthouse": "ng build --configuration demo --output-path dist/lighthouse && lhci autorun",
    "prebuild": "npm run lint",
    "build": "ng build",
    "prebuild:demo": "npm run lint",
    "build:demo": "ng build --configuration demo --base-href /bimap/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@12.2.3",
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/google.maps": "^3.67.0",
    "@types/leaflet": "^1.9.23",
    "angular-eslint": "^22.8.0",
    "daisyui": "^5.8.3",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.3",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "postcss": "^8.5.34",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
