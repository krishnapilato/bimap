# BiMap — environment template.
#
#     cp .env.example .env
#
# .env is git-ignored. Nothing in this file is a real credential.
#
# Author: Khova Krishna Pilato

# ── Build ────────────────────────────────────────────────────────────────────
# Bump this and rebuild to move both services to a new JDK. Nothing else changes.
JAVA_VERSION=26
BIMAP_VERSION=2.0.0

# ── Database ─────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=bimap
DB_PASSWORD=change-me-application
DB_POOL_SIZE=10

# ── Tokens ───────────────────────────────────────────────────────────────────
# Both services sign and verify with this key, so it must be identical for both and at least
# 64 characters. Generate one with:
#     openssl rand -base64 64 | tr -d '\n'
BIMAP_JWT_SECRET=replace-this-with-at-least-sixty-four-random-characters-before-deploying
BIMAP_JWT_ISSUER=bimap
BIMAP_ACCESS_TOKEN_TTL=15m
BIMAP_REFRESH_TOKEN_TTL=30d

# ── Application ──────────────────────────────────────────────────────────────
BIMAP_APP_URL=http://localhost:4200
BIMAP_CORS_ORIGINS=http://localhost:4200
IAM_PUBLIC_PORT=9843
BUSINESS_PUBLIC_PORT=9844

# Closed by default in production: accounts arrive by invitation from an administrator.
BIMAP_SELF_REGISTRATION=false
BIMAP_MAX_LOGIN_ATTEMPTS=5

# Google sign-in. Leave empty to turn the /auth/google endpoint off.
GOOGLE_CLIENT_ID=

# ── Seed accounts ────────────────────────────────────────────────────────────
# The five accounts in iam-service/src/main/resources/seed/users.json.
# Leave BIMAP_SEED_PASSWORD EMPTY in production: the accounts are then created pending
# activation and each person sets their own password from the emailed link.
# Set it only for a local run where you want to sign in immediately.
BIMAP_SEED_ENABLED=true
BIMAP_SEED_PASSWORD=

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@bimap.local
MAIL_FROM_NAME=BiMap
MAIL_ENABLED=true

# ── Upstream APIs ────────────────────────────────────────────────────────────
# None of these offers server-side search, so answers are cached and filtered by us.
# Set any cache TTL to 0s to send every request straight through to the source.
COMUNI_ITA_URL=https://comuni-ita.nicolorebaioli.dev
COMUNI_ITA_CACHE_TTL=24h
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CACHE_TTL=12h
CODICE_UNIVOCO_URL=https://codiceunivoco.it
CODICE_UNIVOCO_CACHE_TTL=12h
INTEGRATION_USER_AGENT=BiMap/2.0 (https://github.com/krishnapilato/bimap)

# ── Logging ──────────────────────────────────────────────────────────────────
# The prod profile emits one JSON object per line, ready for a log shipper.
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN
LOG_LEVEL_SECURITY=INFO
